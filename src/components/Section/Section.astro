---
interface Props {
	class?: string;
	title: string;
}

const { class: className, title, ...attrs } = Astro.props;
---

<style>
	.root {
		display: grid;
		grid-gap: 2ch;
		grid-template-areas:
			"header"
			"body";

		@media print, screen and (min-width: 600px) {
			grid-template-areas: "header body";
			grid-template-columns: auto 1fr;
		}

		@media screen and (min-width: 780px) {
			grid-template-columns: 2fr 9fr;
		}
	}

	header {
		grid-area: header;

		@media print, screen and (min-width: 600px) AND (max-width: 779px) {
			writing-mode: vertical-rl;
		}
	}

	h2 {
		@media screen and (min-width: 780px) {
			text-align: inline-end;
		}
	}

	.body {
		grid-area: body;
	}
</style>

<section class:list={["root", className]} {...attrs}>
	<header>
		<h2>{title}</h2>
	</header>

	<section class="body">
		<slot />
	</section>
</section>
