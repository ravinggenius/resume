---
import { getEntry } from "astro:content";

const maybeProfile = await getEntry("profiles", "default");

if (!maybeProfile) {
	return new Response(null, { status: 404 });
}

const { data: profile } = maybeProfile;
---

<style>
	.root {
		display: grid;
		grid-gap: 2ch;
		grid-template-areas:
			"header"
			"body"
			"nav";

		@media print, screen and (min-width: 520px) {
			grid-template-areas: "header body" "header nav";
			grid-template-columns: 1fr max-content;
		}
	}

	header {
		grid-area: header;
		writing-mode: unset;
	}

	.name {
		grid-area: name;
		margin-inline-end: 2ch;
	}

	.title {
		color: #777777;
		display: block;
		grid-area: title;
		text-wrap: balance;
	}

	nav {
		grid-area: nav;

		@media print {
			display: none;
		}
	}

	address {
		font-style: normal;
	}

	ul {
		display: flex;
		flex-direction: row;
		gap: 2.5ch;
		list-style: none;
	}

	.body {
		grid-area: body;

		@media print, screen and (min-width: 520px) {
			text-align: end;
		}
	}
</style>

<section class="root">
	<header>
		<h1 class="name">{profile.name}</h1>
		<p class="title">{profile.label}</p>
	</header>

	<section class="body">
		<address>
			{profile.location.city}, {profile.location.region}
		</address>
		<address>
			<a href={`mailto:${profile.email}`}>{profile.email}</a>
		</address>
		<address>
			<a href={`tel:${profile.phone}`}>{profile.phone}</a>
		</address>
		<address>
			<a href={profile.url} rel="noopener noreferrer" target="_blank">
				{profile.url.replace(/^https?:\/\//, "").replace(/\/$/, "")}
			</a>
		</address>
	</section>

	{
		profile.profiles?.length > 0 ? (
			<nav>
				<ul>
					{profile.profiles.map((profile) => (
						<li>
							<a
								href={profile.url}
								rel="noopener noreferrer"
								target="_blank"
							>
								{profile.network}
							</a>
						</li>
					))}
				</ul>
			</nav>
		) : null
	}
</section>
