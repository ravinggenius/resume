---
import { getCollection } from "astro:content";
import { parseISO } from "date-fns";

import { countMonthsAgo } from "@/utilities/count-months-ago";

import CompanyCard from "../CompanyCard/CompanyCard.astro";
import Section from "../Section/Section.astro";

const experiences = await getCollection("workExperiences");
---

<style>
	ol {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		list-style-type: none;
	}
</style>

{
	experiences.length > 0 ? (
		<Section title="Experience">
			<ol>
				{experiences
					.toSorted(
						(a, b) =>
							countMonthsAgo(parseISO(a.data.startDate)) -
							countMonthsAgo(parseISO(b.data.startDate))
					)
					.map((job) => (
						<li>
							<CompanyCard
								{...job.data}
								title={job.data.position}
								startedAt={job.data.startDate}
								stoppedAt={job.data.endDate}
							/>
						</li>
					))}
			</ol>
		</Section>
	) : null
}
