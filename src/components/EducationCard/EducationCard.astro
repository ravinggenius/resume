---
import { normalizeDate } from "@/utilities/normalize-date";

import DateRange from "../DateRange/DateRange.astro";
import Markdown from "../Markdown/Markdown.astro";

interface Props {
	institution: string;
	area: string;
	studyType?: string;
	startDate: string;
	endDate?: string;
	details: string;
}

const { institution, area, studyType, startDate, endDate, details } =
	Astro.props;
---

<style>
	.root {
		display: grid;
		gap: 0.5rem;
		grid-template-areas:
			"facts"
			"details";
	}

	.study-type {
		font-size: initial;
		font-weight: normal;
	}

	.area {
		grid-area: area;
	}

	.institution {
		color: #777777;
		display: block;
		grid-area: institution;
		white-space: wrap;
	}

	.range {
		display: inline-block;
		grid-area: range;

		@media print, screen and (min-width: 400px) {
			justify-self: end;
			text-align: end;
		}
	}

	.facts {
		align-items: baseline;
		display: grid;
		gap: 1ch;
		grid-area: facts;
		grid-template-areas:
			"area"
			"institution"
			"range";

		@media screen and (min-width: 400px) {
			grid-template-areas:
				"area area"
				"institution range";
			grid-template-columns: fit-content 1fr;
		}

		@media print, screen and (min-width: 550px) {
			grid-template-areas: "area institution range";
			grid-template-columns: max-content max-content 1fr;
		}
	}

	.summary {
		grid-area: summary;
	}
</style>

<article class="root">
	<header class="facts">
		<h3 class="area">
			{area}
			{studyType ? " " : null}
			{studyType ? <span class="study-type">({studyType})</span> : null}
		</h3>

		<span class="institution">{institution}</span>

		<DateRange
			class="range"
			startedOn={normalizeDate(startDate)}
			stoppedOn={endDate ? normalizeDate(endDate) : undefined}
		/>
	</header>

	<Markdown as="section" class="details" content={details} />
</article>
