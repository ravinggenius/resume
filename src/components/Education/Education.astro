---
import { getCollection } from "astro:content";

import EducationCard from "../EducationCard/EducationCard.astro";
import Section from "../Section/Section.astro";

const educations = await getCollection("educations");
---

<style>
	ol {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		list-style-type: none;
	}
</style>

{
	educations.length > 0 ? (
		<Section title="Education">
			<ol>
				{educations.map((education) => (
					<li>
						<EducationCard {...education.data} />
					</li>
				))}
			</ol>
		</Section>
	) : null
}
