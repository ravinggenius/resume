---
import { getCollection, type CollectionEntry } from "astro:content";

import CardListing from "../CardListing/CardListing.astro";
import EducationCard from "../EducationCard/EducationCard.astro";
import Section from "../Section/Section.astro";

const educations = await getCollection("educations");
---

{
	educations.length > 0 ? (
		<Section title="Education">
			<CardListing items={educations}>
				{({ data: education }: CollectionEntry<"educations">) => (
					<EducationCard {...education} />
				)}
			</CardListing>
		</Section>
	) : null
}
