---
interface SkillTag {
	name: string;
	proficiency: 1 | 2 | 3 | 4 | 5;
}

interface Props {
	family: string;
	tags: Array<SkillTag>;
}

const { family, tags } = Astro.props;

const sortedTags = tags.toSorted((a, b) => {
	const prof = b.proficiency - a.proficiency;

	if (prof !== 0) {
		return prof;
	}

	return a.name.localeCompare(b.name, undefined, { sensitivity: "base" });
});
---

<style>
	.title {
	}

	.tag {
	}

	.list {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		gap: 0 2ch;
		list-style-type: none;
	}

	.body {
	}

	.root {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
</style>

<article class="root">
	<header><h3 class="title">{family}</h3></header>

	<section class="body">
		<ol class="list">
			{sortedTags.map(({ name }) => <li class="tag">{name}</li>)}
		</ol>
	</section>
</article>
