---
import { getCollection } from "astro:content";

import Section from "../Section/Section.astro";
import SkillCard from "../SkillCard/SkillCard.astro";

const skills = await getCollection("skills");
---

<style>
	.skill-categories > :global(.body) {
		container-type: inline-size;
		display: grid;
		gap: 1rem 3ch;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
	}
</style>

{
	skills.length > 0 ? (
		<Section class="skill-categories" title="Skills">
			{skills.map((skill) => (
				<SkillCard {...skill.data} />
			))}
		</Section>
	) : null
}
