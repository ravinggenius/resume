---
import { getCollection, type CollectionEntry } from "astro:content";

import CardListing from "../CardListing/CardListing.astro";
import Section from "../Section/Section.astro";
import TestimonialCard from "../TestimonialCard/TestimonialCard.astro";

const testimonials = await getCollection("testimonials");
---

{
	testimonials.length > 0 ? (
		<Section title="Testimonials">
			<CardListing items={testimonials}>
				{({ data: testimonial }: CollectionEntry<"testimonials">) => (
					<TestimonialCard {...testimonial} />
				)}
			</CardListing>
		</Section>
	) : null
}
