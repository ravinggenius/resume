---
interface Item {
	data: {
		media?: "all" | "print" | "screen";
	};
}

interface Props {
	class?: string;
	items: Array<Item>;
}

const { class: className, items, ...attrs } = Astro.props;
---

<style>
	@media print {
		[data-media="screen"] {
			display: none;
		}
	}

	ol {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		list-style-type: none;
	}
</style>

<ol class:list={["card-listing", className]} {...attrs}>
	{
		await Promise.all(
			items.map(async (item) => (
				<li data-media={item.data.media ?? "all"}>
					{await Astro.slots.render("default", [item])}
				</li>
			))
		)
	}
</ol>
