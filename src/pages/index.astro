---
import { getEntry } from "astro:content";

import Education from "@/components/Education/Education.astro";
import Introduction from "@/components/Introduction/Introduction.astro";
import Layout from "@/components/Layout/Layout.astro";
import Skills from "@/components/Skills/Skills.astro";
import Summary from "@/components/Summary/Summary.astro";
import Testimonials from "@/components/Testimonials/Testimonials.astro";
import Work from "@/components/Work/Work.astro";

const maybeProfile = await getEntry("profiles", "default");

if (!maybeProfile) {
	return new Response(null, { status: 404 });
}

const { data: profile } = maybeProfile;
---

<Layout name={profile.name} title={profile.label}>
	<Introduction />

	<Summary />

	<Skills />

	<Work />

	<Education />

	<Testimonials />
</Layout>
