---
import Introduction from "@/components/Introduction/Introduction.astro";
import Summary from "@/components/Summary/Summary.astro";
import resume from "@/data/resume.json";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>{resume.basics.name} | Résumé</title>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta
			name="description"
			content={`${resume.basics.name} - ${resume.basics.label}`}
		/>
		<meta name="generator" content={Astro.generator} />
		<meta name="viewport" content="width=device-width" />
		<style is:global>
			*,
			*::before,
			*::after {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			body {
				font-family:
					"Lato", "Helvetica Neue", Helvetica, Arial, sans-serif;
			}

			a {
				color: #337ab7;
				text-decoration: none;

				&:active,
				&:focus,
				&:hover {
					color: #23527c;
					text-decoration: underline;
				}
			}

			p {
				max-block-size: 62ch;
			}
		</style>
		<style>
			html {
				scrollbar-gutter: stable;
			}

			body {
				margin: 2rem;
			}

			main {
				display: flex;
				flex-direction: column;
				gap: 2rem;
			}
		</style>
	</head>

	<body>
		<main>
			<Introduction />

			<Summary />
		</main>
	</body>
</html>
